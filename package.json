{
  "name": "dx-monitel-themes",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint --fix designsystem",
    "prepare": "husky install",
    "storybook": "ng run dx-monitel-components:storybook --no-open",
    "build-storybook": "NODE_OPTIONS=--max_old_space_size=8192 ng run dx-monitel-components:build-storybook --test",
    "styles": "sass ${PWD}/src/assets/bundles:${PWD}/src/assets/bundles"
