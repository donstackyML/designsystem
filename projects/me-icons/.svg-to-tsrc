{
  "conversionType": "files",
  "srcFiles": [
    "./svg-icons/**/*.svg"
  ],
  "outputDirectory": "./dist/icons",
  "interfaceName": "MeIcon",
  "typeName": "meIcons",
  "prefix": "",
  "namePrefix": "",
  "generateType": true,
  "exportCompleteIconSet": true,
  "completeIconSetName": "MeIconSet",
